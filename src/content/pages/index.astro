---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
const projects = (await getCollection('projects')).slice(0,2);
---
<BaseLayout>
  <div class="home-shell">
    <section class="intro">
      <p class="eyebrow">Персональный хаб Ильи</p>
      <h1>Исследую системы.<br />Рассказываю истории.</h1>
      <p class="intro-text">Игры, социология, аналитика, разработка — и жизнь, которую приходится собирать заново.</p>
      <a class="button" href={posts[0] ? `${base}/blog/${posts[0].id}` : `${base}/blog`}>Начать с главного текста</a>
    </section>
    <section class="modules" aria-label="Основные разделы">
      <a class="module feature" href={posts[0] ? `${base}/blog/${posts[0].id}` : `${base}/blog`}>
        <small>В фокусе</small><h2>{posts[0]?.data.title ?? 'Субъективное восприятие времени'}</h2>
        <p>{posts[0]?.data.description ?? 'The Longing, ожидание и личный опыт онкологии.'}</p><span>Читать эссе →</span>
      </a>
      <a class="module" href={`${base}/projects`}>
        <small>Проекты</small><h2>Инструменты</h2>
        <p>{projects.length ? projects.map((project) => project.data.title).join(' · ') : 'Gamer Lair · Research Signal'}</p><span>Смотреть проекты →</span>
      </a>
      <a class="module" href={`${base}/support`}>
        <small>Статус</small><h2>На связи</h2><p>Пишу новый материал и продолжаю разработку.</p><span>Поддержать →</span>
      </a>
    </section>
  </div>
</BaseLayout>
<style>
  .home-shell{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:clamp(2rem,6vw,5.5rem);align-items:center}
  .intro{padding-block:2rem}.intro h1{max-width:620px;margin:0;font-size:clamp(3rem,6.6vw,5.7rem);line-height:.94;letter-spacing:-.07em}
  .intro-text{max-width:520px;margin:1.8rem 0 2.2rem;color:var(--muted);font-size:clamp(1rem,1.7vw,1.18rem)}
  .modules{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:1rem;border-radius:24px;background:rgb(17 26 33/.78)}
  .module{display:flex;min-height:220px;flex-direction:column;padding:clamp(1.35rem,3vw,2rem);border:1px solid var(--border);border-radius:17px;background:var(--surface-2);transition:border-color .18s ease,transform .18s ease}
  .module:hover{border-color:#43616c;transform:translateY(-2px)}.module.feature{grid-column:1/-1;min-height:270px;background:linear-gradient(135deg,#19383c,var(--surface-2) 72%)}
  .module small{color:var(--cyan);font-size:.68rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.module h2{max-width:540px;margin:1.3rem 0 .7rem;font-size:clamp(1.55rem,3.3vw,2.55rem);line-height:1.05;letter-spacing:-.05em}
  .module:not(.feature) h2{font-size:clamp(1.35rem,2.5vw,1.8rem)}.module p{margin:0;color:var(--muted)}.module span{margin-top:auto;padding-top:1.5rem;color:var(--amber);font-size:.84rem;font-weight:750}
  @media(max-width:850px){.home-shell{grid-template-columns:1fr}.intro{padding-block:0 1rem}}@media(max-width:520px){.modules{grid-template-columns:1fr;padding:.7rem}.module.feature{grid-column:auto;min-height:245px}}
</style>
