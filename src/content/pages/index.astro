---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const projects = (await getCollection('projects')).slice(0, 2);
---

<BaseLayout>
  <!-- Hero -->
  <section class="mb-14">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4 text-white">
      Персональный хаб, эссе об играх, софт и хроника борьбы с болезнью
    </h1>
    <p class="text-lg text-slate-400 leading-relaxed max-w-2xl mb-6">
      Здесь я делюсь эссе о нарративах и культуре видеоигр, выкладываю инструменты и AI-надстройки, которые разрабатываю для анализа данных, и открыто веду дневник лечения онкологии.
    </p>
    <div class="flex items-center gap-4">
      <a href="/blog" class="bg-[#1e293b] hover:bg-[#334155] text-white px-4 py-2 rounded-lg border border-slate-700 transition-colors">Читать блог</a>
      <a href="/support" class="bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30 px-4 py-2 rounded-lg transition-colors">Как помочь лечению →</a>
    </div>
  </section>

  <!-- Текущий статус / Чекпоинт -->
  <div class="bg-[#161f2e] border border-slate-800 rounded-xl p-5 mb-14">
    <div class="flex items-center gap-2 mb-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <h2 class="text-xs uppercase tracking-wider font-semibold text-slate-400">Текущий статус</h2>
    </div>
    <p class="text-slate-300 text-sm">
      <strong>Терапия:</strong> Прохождение планового лечения. <br/>
      <strong>В разработке:</strong> Обновление статистического макроса и новое эссе об игровых мирах.
    </p>
  </div>

  <!-- Витрина проектов -->
  <section class="mb-14">
    <div class="flex justify-between items-baseline mb-6">
      <h2 class="text-2xl font-bold text-white">Проекты и инструменты</h2>
      <a href="/projects" class="text-sm text-[#38bdf8] hover:underline">Все проекты →</a>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {projects.map((p) => (
        <div class="bg-[#131b26] border border-slate-800/80 rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start gap-2 mb-2">
              <h3 class="text-lg font-semibold text-white">{p.data.title}</h3>
              <span class="text-xs bg-slate-800 text-slate-400 px-2 py-0.5 rounded border border-slate-700">{p.data.status}</span>
            </div>
            <p class="text-sm text-slate-400 mb-4">{p.data.description}</p>
          </div>
          <div class="flex flex-wrap gap-1.5 mt-auto">
            {p.data.techStack.map(tech => (
              <span class="text-[11px] bg-slate-900 text-slate-400 px-2 py-0.5 rounded">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Свежее в блоге -->
  <section>
    <div class="flex justify-between items-baseline mb-6">
      <h2 class="text-2xl font-bold text-white">Свежие тексты</h2>
      <a href="/blog" class="text-sm text-[#38bdf8] hover:underline">Все записи →</a>
    </div>
    <div class="space-y-4">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="block bg-[#131b26] hover:bg-[#182230] border border-slate-800/80 rounded-xl p-5 transition-colors">
          <div class="text-xs text-slate-500 mb-1">
            {post.data.pubDate.toLocaleDateString('ru-RU')} • <span class="capitalize text-slate-400">{post.data.category}</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">{post.data.title}</h3>
          <p class="text-sm text-slate-400">{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>