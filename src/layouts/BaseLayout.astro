---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "hedgefog.fun", 
  description = "Персональный хаб исследователя: прикладные AI-инструменты, игровая эссеистика и хроника преодоления." 
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import '../styles/global.css';
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${base}/logo.png`} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={`${base}/`} class="brand" aria-label="hedgefog.fun — главная">
          <img src={`${base}/logo.png`} alt="" />
          <span>hedgefog<strong>.fun</strong></span>
        </a>
        <nav aria-label="Основная навигация">
          <a href={`${base}/`}>Главная</a>
          <a href={`${base}/blog`}>Блог</a>
          <a href={`${base}/projects`}>Проекты</a>
          <a href={`${base}/about`}>Обо мне</a>
          <a href={`${base}/support`} class="support-link">Поддержать</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span class="copyright">© {new Date().getFullYear()} hedgefog.fun</span>
        <nav class="social-links" aria-label="Социальные сети">
          <a href="https://t.me/Hedgefog" target="_blank" rel="me noreferrer">Telegram</a>
          <a href="https://x.com/hedgef0g" target="_blank" rel="me noreferrer">X.com</a>
          <a href="https://www.youtube.com/@Hedgef0g" target="_blank" rel="me noreferrer">YouTube</a>
          <a href="https://www.twitch.tv/hedgefoggwp" target="_blank" rel="me noreferrer">Twitch</a>
          <a href="https://steamcommunity.com/id/hedgef0g/" target="_blank" rel="me noreferrer">Steam</a>
          <a href="https://github.com/hedgef0g" target="_blank" rel="me noreferrer">GitHub</a>
        </nav>
        <div class="footer-support">
          <a href={`${base}/support`}>Помощь в лечении</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .site-header{position:sticky;z-index:20;top:0;border-bottom:1px solid rgb(38 54 64/.9);background:rgb(14 23 30/.88);backdrop-filter:blur(16px)}
  .header-inner,.site-main,.footer-inner{width:min(1120px,calc(100% - 2rem));margin-inline:auto}
  .header-inner{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}
  .brand{display:flex;align-items:center;gap:.75rem;font-size:1.22rem;font-weight:800;letter-spacing:-.045em}
  .brand img{width:42px;height:42px;border-radius:12px;object-fit:cover;object-position:center 27%}
  .brand strong{color:var(--amber);font-weight:500}
  .site-header nav{display:flex;align-items:center;gap:1.65rem;color:#b1bdc3;font-size:.88rem}
  .site-header nav a{transition:color .18s ease}.site-header nav a:hover{color:var(--text)}.site-header .support-link{color:var(--amber)}
  .site-main{min-height:calc(100vh - 160px);padding-block:clamp(3rem,7vw,6.5rem)}
  .site-footer{border-top:1px solid var(--border);color:#788991;font-size:.82rem}
  .footer-inner{min-height:100px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1.5rem}
  .social-links{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:.55rem 1rem}
  .social-links a,.footer-support a{transition:color .18s ease}.social-links a:hover{color:var(--cyan)}.footer-support a{color:var(--amber)}.footer-support a:hover{color:#f0bf89}
  @media(max-width:820px){.footer-inner{grid-template-columns:1fr auto;padding-block:1.4rem}.social-links{grid-column:1/-1;grid-row:2;justify-content:flex-start}}
  @media(max-width:620px){.site-header nav a:not(.support-link){display:none}.header-inner,.site-main,.footer-inner{width:min(100% - 1.25rem,1120px)}.footer-inner{grid-template-columns:1fr;align-items:start}.social-links{grid-column:1;grid-row:auto}.footer-support{grid-row:2}}
</style>
