---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Обо мне — hedgefog.fun" description="Профессиональный путь, проекты и личная история Ильи.">
  <div class="about-layout">
    <figure class="profile-photo">
      <img src={`${base}/ilia-kulikov.webp`} alt="Илья Куликов" width="720" height="720" />
    </figure>
    <article>
      <p class="eyebrow">Обо мне</p>
      <h1 class="page-title">Илья — исследователь, автор и создатель инструментов.</h1>
      <div class="about-copy">
        <p>Я работаю в маркетинговых и социальных исследованиях и прошёл путь от анализа данных и статистической обработки до управления исследовательскими проектами. Сейчас моя профессиональная роль — Lead Research Manager: я соединяю методологию, данные и задачи бизнеса, стараясь превращать сложные результаты в понятные решения.</p>
        <p>Параллельно я разрабатываю собственные инструменты. Research Insights Toolkit автоматизирует проверку статистической значимости в Excel, а Gamer Lair помогает организовать большую игровую библиотеку в Playnite. Мне интересны практическая аналитика, автоматизация и системы, которые снимают с человека рутинную работу.</p>
        <p>Игры для меня — не только развлечение, но и язык для разговора об обществе, культуре и личном опыте. Здесь появляются эссе о видеоиграх, социологических концепциях и субъективном восприятии времени. Ещё я играю на гитаре, интересуюсь историей, технологиями и научно-популярной литературой.</p>
        <p>Отдельная часть этого сайта — жизнь после онкологического диагноза. Я прохожу лечение и честно пишу о том, как болезнь перестраивает планы, работу и ощущение времени. Это не медицинский блог, а личная хроника попытки продолжать исследовать, создавать и жить.</p>
      </div>
      <section class="illness-story" aria-labelledby="illness-story-title">
        <p class="eyebrow">История болезни</p>
        <h2 id="illness-story-title">Короткая хронология</h2>
        <ol>
          <li><time datetime="2025">2025</time><p>Онкологический диагноз.</p></li>
          <li><time datetime="2025-11">Ноябрь 2025 — январь 2026</time><p>Четыре курса химиотерапии.</p></li>
          <li><time datetime="2026-02">Февраль 2026</time><p>Операции.</p></li>
          <li><time datetime="2026-03">Весна — лето 2026</time><p>Девять курсов химиотерапии по схеме FOLFOX.</p></li>
          <li class="current"><time>Сейчас</time><p>Подозрение на канцероматоз брюшной полости, две экстренные госпитализации и несколько суток в стационаре на внутривенном питании.</p></li>
        </ol>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .about-layout{display:grid;grid-template-columns:minmax(230px,.72fr) minmax(0,1.6fr);gap:clamp(2.2rem,7vw,6rem);align-items:start}
  .profile-photo{position:sticky;top:110px;margin:0;border:1px solid var(--border);border-radius:22px;background:var(--surface);overflow:hidden;box-shadow:0 22px 60px rgb(0 0 0/.22)}.profile-photo img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}
  .about-copy{max-width:760px;margin-top:2.2rem;color:#b3bfc4;font-size:1.04rem}.about-copy p+p{margin-top:1.35rem}
  .illness-story{max-width:760px;margin-top:3.5rem;padding-top:2.5rem;border-top:1px solid var(--border)}.illness-story .eyebrow{margin-bottom:.65rem}.illness-story h2{margin:0 0 1.5rem;font-size:clamp(1.6rem,4vw,2.25rem);letter-spacing:-.045em}
  .illness-story ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--border)}.illness-story li{display:grid;grid-template-columns:minmax(150px,.45fr) 1fr;gap:1.4rem;padding:1rem .15rem;border-bottom:1px solid var(--border)}.illness-story time{color:var(--cyan);font-size:.82rem;font-weight:750}.illness-story li p{margin:0;color:#b3bfc4}.illness-story li.current time{color:var(--amber)}
  @media(max-width:520px){.illness-story li{grid-template-columns:1fr;gap:.3rem}}
  @media(max-width:760px){.about-layout{grid-template-columns:1fr}.profile-photo{position:static;max-width:420px;width:100%}.about-layout article{grid-row:1}.profile-photo{grid-row:2}}
</style>
