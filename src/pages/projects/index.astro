---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout title="Проекты — hedgefog.fun">
  <h1 class="text-3xl font-bold text-white mb-8">Проекты и инструменты</h1>
  {projects.length === 0 ? (
    <p class="text-slate-400">Раздел готовится к публикации.</p>
  ) : (
    <div class="grid sm:grid-cols-2 gap-4">
      {projects.map((project) => (
        <article class="bg-[#131b26] border border-slate-800 rounded-xl p-5">
          <h2 class="text-xl font-semibold text-white">{project.data.title}</h2>
          <p class="text-slate-400 mt-2">{project.data.description}</p>
        </article>
      ))}
    </div>
  )}
</BaseLayout>
