---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout title="Проекты — hedgefog.fun">
  <p class="eyebrow">Практическая работа</p>
  <h1 class="page-title">Проекты и инструменты</h1>
  <p class="page-lead">Продукты и эксперименты на пересечении данных, автоматизации и игр.</p>
  {projects.length === 0 ? (
    <p class="empty-state">Раздел готовится к публикации.</p>
  ) : (
    <div class="card-grid">
      {projects.map((project) => (
        <article class="content-card">
          <small class="eyebrow">{project.data.status}</small><h2>{project.data.title}</h2><p>{project.data.description}</p>
        </article>
      ))}
    </div>
  )}
</BaseLayout>
<style>.page-lead{margin:1.2rem 0 3rem}</style>
