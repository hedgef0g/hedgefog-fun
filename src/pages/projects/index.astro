---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Проекты — hedgefog.fun">
  <p class="eyebrow">Практическая работа</p>
  <h1 class="page-title">Проекты и инструменты</h1>
  <p class="page-lead">Продукты и эксперименты на пересечении данных, автоматизации и игр.</p>
  {projects.length === 0 ? (
    <p class="empty-state">Раздел готовится к публикации.</p>
  ) : (
    <div class="card-grid">
      {projects.map((project) => (
        <a class="content-card" href={`${base}/projects/${project.id}`}>
          <small class="eyebrow">{project.data.status}</small>
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
          <div class="project-tech">{project.data.techStack.slice(0, 3).join(' · ')}</div>
          <span class="card-link">Подробнее →</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
<style>
  .page-lead{margin:1.2rem 0 3rem}
  .project-tech{margin-top:1rem;color:#778a92;font-size:.76rem}
</style>
