---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Эссе и блог — hedgefog.fun">
  <p class="eyebrow">Наблюдения и разборы</p>
  <h1 class="page-title">Эссе и блог</h1>
  <p class="page-lead">Игры как способ говорить о культуре, обществе, времени и личном опыте.</p>
  {posts.length === 0 ? (
    <p class="empty-state">Здесь скоро появятся первые публикации.</p>
  ) : (
    <div class="card-grid">
      {posts.map((post) => (
        <a href={`${base}/blog/${post.id}`} class="content-card">
          <small class="eyebrow">{post.data.category} · {post.data.pubDate.toLocaleDateString('ru-RU')}</small>
          <h2>{post.data.title}</h2><p>{post.data.description}</p><span class="card-link">Читать →</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
<style>.page-lead{margin:1.2rem 0 3rem}</style>
