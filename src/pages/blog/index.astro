---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Эссе и блог — hedgefog.fun">
  <h1 class="text-3xl font-bold text-white mb-8">Эссе и блог</h1>
  {posts.length === 0 ? (
    <p class="text-slate-400">Здесь скоро появятся первые публикации.</p>
  ) : (
    <div class="space-y-4">
      {posts.map((post) => (
        <a href={`${base}/blog/${post.id}`} class="block bg-[#131b26] border border-slate-800 rounded-xl p-5">
          <h2 class="text-xl font-semibold text-white">{post.data.title}</h2>
          <p class="text-slate-400 mt-2">{post.data.description}</p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
